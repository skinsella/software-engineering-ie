ec\"></rect><text x=\"504\" y=\"81\" font-size=\"11\" fill=\"#4a5a52\" letter-spacing=\".04em\">Sem 1</text><text x=\"597\" y=\"100\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"700\" fill=\"#0a3f2c\">On campus</text><text x=\"597\" y=\"115\" text-anchor=\"middle\" font-size=\"11\" fill=\"#4a5a52\">continuously assessed</text><rect x=\"490\" y=\"136\" width=\"215\" height=\"64\" rx=\"12\" fill=\"#00B140\"></rect><text x=\"504\" y=\"157\" font-size=\"11\" fill=\"#eafff2\" letter-spacing=\".04em\">Sem 2</text><text x=\"597\" y=\"176\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"700\" fill=\"#ffffff\">Residency 4</text><text x=\"597\" y=\"191\" text-anchor=\"middle\" font-size=\"11\" fill=\"#eafff2\">paid residency</text><text x=\"729\" y=\"22\" font-size=\"17\" font-weight=\"700\" fill=\"#003726\">Year 4</text><text x=\"729\" y=\"42\" font-size=\"12\" fill=\"#4a5a52\" letter-spacing=\".04em\">MSc, LK315</text><rect x=\"729\" y=\"60\" width=\"215\" height=\"64\" rx=\"12\" fill=\"#e8f1ec\"></rect><text x=\"743\" y=\"81\" font-size=\"11\" fill=\"#4a5a52\" letter-spacing=\".04em\">Sem 1</text><text x=\"836\" y=\"100\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"700\" fill=\"#0a3f2c\">On campus</text><text x=\"836\" y=\"115\" text-anchor=\"middle\" font-size=\"11\" fill=\"#4a5a52\">continuously assessed</text><rect x=\"729\" y=\"136\" width=\"215\" height=\"64\" rx=\"12\" fill=\"#00B140\"></rect><text x=\"743\" y=\"157\" font-size=\"11\" fill=\"#eafff2\" letter-spacing=\".04em\">Sem 2</text><text x=\"836\" y=\"176\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"700\" fill=\"#ffffff\">Residency 5</text><text x=\"836\" y=\"191\" text-anchor=\"middle\" font-size=\"11\" fill=\"#eafff2\">paid residency</text></svg>\n  <p style=\"margin:1.5rem auto 0;max-width:72ch;text-align:center;color:var(--ink-70);\">Roughly half the degree is spent on paid residency. Exit with a BSc (Hons) after Year 3, or continue to the integrated MSc in Year 4.</p>\n</div></div>"}, "elements": []}]}]}, {"id": "4ee256b", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "f461ea1", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "f2d6c24", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"\" style=\"padding-block:var(--section-y);\">\n<div class=\"ise-container\">\n  <div style=\"max-width:54ch;margin-bottom:2rem;\"><p class=\"ise-eyebrow\">What you will study</p><h2>Modules, year by year</h2></div>\n  <div style=\"display:grid;grid-template-columns:repeat(4,1fr);gap:1.25rem;align-items:start;\"><div class=\"ise-card\"><p class=\"ise-eyebrow\" style=\"margin:0 0 .15rem;\">Year 1</p><h3 style=\"margin:0;font-size:1.05rem;color:var(--ul-green-heritage);\">BSc, LM173</h3><p style=\"font-weight:700;font-size:.72rem;text-transform:uppercase;letter-spacing:.05em;color:#77857e;margin:1rem 0 .4rem;\">Semester 1</p><ul style=\"margin:0;padding-left:1.1rem;font-size:.9rem;line-height:1.35;\"><li style=\"margin:0 0 .4rem;color:var(--ink-70);\">CS4421 Problem Solving with Computers</li><li style=\"margin:0 0 .4rem;color:var(--ink-70);\">CS4431 Effectively Building Software with Others</li></ul><p style=\"font-weight:700;font-size:.72rem;text-transform:uppercase;letter-spacing:.05em;color:#77857e;margin:1rem 0 .4rem;\">Semester 2</p><ul style=\"margin:0;padding-left:1.1rem;font-size:.9rem;line-height:1.35;\"><li style=\"margin:0 0 .4rem;color:var(--ink-70);\">CS4422 Data Centric Computing</li><li style=\"margin:0 0 .4rem;color:var(--ink-70);\">CS4431 Computation and Architecture Part 1</li></ul><p style=\"font-weight:700;font-size:.72rem;text-transform:uppercase;letter-spacing:.05em;color:#77857e;margin:1rem 0 .4rem;\">Semester 3</p><ul style=\"margin:0;padding-left:1.1rem;font-size:.9rem;line-height:1.35;\"><li style=\"margin:0 0 .4rem;color:var(--ink-70);\">CS4443 Computation and Architecture Part 2</li><li style=\"margin:0 0 .4rem;font-weight:600;color:var(--ul-green);\">CS4453 Residency 1: Software Systems / Dev Part 1</li></ul></div><div class=\"ise-card\"><p class=\"ise-eyebrow\" style=\"margin:0 0 .15rem;\">Year 2</p><h3 style=\"margin:0;font-size:1.05rem;color:var(--ul-green-heritage);\">BSc, LM173</h3><p style=\"font-weight:700;font-size:.72rem;text-transform:uppercase;letter-spacing:.05em;color:#77857e;margin:1rem 0 .4rem;\">Semester 1</p><ul style=\"margin:0;padding-left:1.1rem;font-size:.9rem;line-height:1.35;\"><li style=\"margin:0 0 .4rem;font-weight:600;color:var(--ul-green);\">CS4444 Residency 2: Software Systems / Dev Part 2</li></ul><p style=\"font-weight:700;font-size:.72rem;text-transform:uppercase;letter-spacing:.05em;color:#77857e;margin:1rem 0 .4rem;\">Semester 2</p><ul style=\"margin:0;padding-left:1.1rem;font-size:.9rem;line-height:1.35;\"><li style=\"margin:0 0 .4rem;color:var(--ink-70);\">CS4445 Human Centric Computing</li><li style=\"margin:0 0 .4rem;color:var(--ink-70);\">CS4455 Ethical Hacking and Security Part 1</li><li style=\"margin:0 0 .4rem;color:var(--ink-70);\">CS4436 Ethical Hacking and Security Part 2</li></ul><p style=\"font-weight:700;font-size:.72rem;text-transform:uppercase;letter-spacing:.05em;color:#77857e;margin:1rem 0 .4rem;\">Semester 3</p><ul style=\"margin:0;padding-left:1.1rem;font-size:.9rem;line-height:1.35;\"><li style=\"margin:0 0 .4rem;font-weight:600;color:var(--ul-green);\">CS4446 Residency 3: User Interaction in Practice</li></ul></div><div class=\"ise-card\"><p class=\"ise-eyebrow\" style=\"margin:0 0 .15rem;\">Year 3</p><h3 style=\"margin:0;font-size:1.05rem;color:var(--ul-green-heritage);\">BSc, LM173</h3><p style=\"font-weight:700;font-size:.72rem;text-transform:uppercase;letter-spacing:.05em;color:#77857e;margin:1rem 0 .4rem;\">Semester 1</p><ul style=\"margin:0;padding-left:1.1rem;font-size:.9rem;line-height:1.35;\"><li style=\"margin:0 0 .4rem;color:var(--ink-70);\">CS4437 Scaling for Reliability and Performance</li><li style=\"margin:0 0 .4rem;color:var(--ink-70);\">CS4447 Computational Thinking</li></ul><p style=\"font-weight:700;font-size:.72rem;text-transform:uppercase;letter-spacing:.05em;color:#77857e;margin:1rem 0 .4rem;\">Semester 2</p><ul style=\"margin:0;padding-left:1.1rem;font-size:.9rem;line-height:1.35;\"><li style=\"margin:0 0 .4rem;font-weight:600;color:var(--ul-green);\">CS4448 Residency 4: Immersive Software Project</li></ul></div><div class=\"ise-card\"><p class=\"ise-eyebrow\" style=\"margin:0 0 .15rem;\">Year 4</p><h3 style=\"margin:0;font-size:1.05rem;color:var(--ul-green-heritage);\">MSc, LK315</h3><p style=\"font-weight:700;font-size:.72rem;text-transform:uppercase;letter-spacing:.05em;color:#77857e;margin:1rem 0 .4rem;\">From Year 3, Semester 3</p><ul style=\"margin:0;padding-left:1.1rem;font-size:.9rem;line-height:1.35;\"><li style=\"margin:0 0 .4rem;color:var(--ink-70);\">CS6513 Research Methods</li></ul><p style=\"font-weight:700;font-size:.72rem;text-transform:uppercase;letter-spacing:.05em;color:#77857e;margin:1rem 0 .4rem;\">Semester 1</p><ul style=\"margin:0;padding-left:1.1rem;font-size:.9rem;line-height:1.35;\"><li style=\"margin:0 0 .4rem;color:var(--ink-70);\">CS6514 Artificial Intelligence and Machine Learning</li><li style=\"margin:0 0 .4rem;color:var(--ink-70);\">CS6524 Software meets World</li></ul><p style=\"font-weight:700;font-size:.72rem;text-transform:uppercase;letter-spacing:.05em;color:#77857e;margin:1rem 0 .4rem;\">Semester 2</p><ul style=\"margin:0;padding-left:1.1rem;font-size:.9rem;line-height:1.35;\"><li style=\"margin:0 0 .4rem;font-weight:600;color:var(--ul-green);\">CS6515 Residency 5a: ISE Research Project Part 1</li><li style=\"margin:0 0 .4rem;font-weight:600;color:var(--ul-green);\">CS6525 Residency 5b: ISE Research Project Part 2</li></ul></div></div>\n</div></div>"}, "elements": []}]}]}, {"id": "0633192", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "7d980ff", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "fbee51f", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ise-band\" style=\"padding-block:var(--section-y);\">\n<div class=\"ise-container\">\n  <div style=\"max-width:54ch;margin-bottom:2rem;\"><p class=\"ise-eyebrow\">What you need to know</p><h2>Entry and key facts</h2></div>\n  <div style=\"display:grid;grid-template-columns:repeat(2,1fr);gap:1.25rem;\"><div class=\"ise-card\"><p class=\"ise-eyebrow\" style=\"margin:0 0 .35rem;\">Award</p><p style=\"margin:0;color:var(--ink-70);\">LM173 BSc and LK315 MSc in Immersive Software Engineering.</p></div><div class=\"ise-card\"><p class=\"ise-eyebrow\" style=\"margin:0 0 .35rem;\">Duration</p><p style=\"margin:0;color:var(--ink-70);\">Four years, an integrated BSc/MSc at level 9 on the NFQ, with an exit opportunity after Year 3 with a BSc (Hons) at level 8.</p></div><div class=\"ise-card\"><p class=\"ise-eyebrow\" style=\"margin:0 0 .35rem;\">Subject area</p><p style=\"margin:0;color:var(--ink-70);\">Engineering and Science.</p></div><div class=\"ise-card\"><p class=\"ise-eyebrow\" style=\"margin:0 0 .35rem;\">CAO points</p><p style=\"margin:0;color:var(--ink-70);\">Entry in 2025 required 651 points. Points combine the Leaving Certificate (up to 625) with the Entrance Submission (up to 200).</p></div><div class=\"ise-card\"><p class=\"ise-eyebrow\" style=\"margin:0 0 .35rem;\">Leaving Certificate</p><p style=\"margin:0;color:var(--ink-70);\">A Leaving Certificate, or an approved equivalent, with at least two H5 grades and four O6 grades, or four H7 grades.</p></div><div class=\"ise-card\"><p class=\"ise-eyebrow\" style=\"margin:0 0 .35rem;\">Subjects</p><p style=\"margin:0;color:var(--ink-70);\">A minimum grade H4 in Mathematics, plus Irish or another language, and English. Contact UL admissions for full details.</p></div><div class=\"ise-card\"><p class=\"ise-eyebrow\" style=\"margin:0 0 .35rem;\">Course fees</p><p style=\"margin:0;color:var(--ink-70);\">ISE fees are the same as for any other BSc in the UL Faculty of Science and Engineering.</p></div></div>\n</div></div>"}, "elements": []}]}]}, {"id": "45dae35", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "3f905e2", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "1d0fe1b", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"\" style=\"padding-block:var(--section-y);\">\n<div class=\"ise-container\">\n  <div style=\"max-width:54ch;margin-bottom:2rem;\"><p class=\"ise-eyebrow\">Applying</p><h2>Entrance submission and routes in</h2></div>\n  <div style=\"display:grid;grid-template-columns:repeat(2,1fr);gap:1.25rem;\">\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">Entrance submission</h3><p style=\"margin:0;color:var(--ink-70);\">Applicants submit either Route A or Route B. You may also be invited to an interview to discuss your submission.</p></div>\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">Special Mathematics Examination</h3><p style=\"margin:0;color:var(--ink-70);\">A Special Mathematics Examination is offered at UL after the Leaving Certificate results if you did not meet the Mathematics requirement.</p></div>\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">Mature students</h3><p style=\"margin:0;color:var(--ink-70);\">Applications from mature students are welcome, through the CAO. See UL's Mature Student Guide and the Mature Student Office.</p></div>\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">International applicants</h3><p style=\"margin:0;color:var(--ink-70);\">Details for international applicants are available through the University of Limerick International Students pages.</p></div>\n  </div>\n  <div style=\"margin-top:1.75rem;\"><a class=\"ise-btn ise-btn--ghost\" href=\"/entrance-submission\">Entrance submission details →</a></div>\n</div></div>"}, "elements": []}]}]}, {"id": "52b1e89", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "8e7a382", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "d8034e3", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ise-split\"><img src=\"/wp-content/themes/hello-elementor-child/assets/photos/course-teach.jpg\" alt=\"\"><div class=\"ise-split__text\"><p class=\"ise-eyebrow\">Inside ISE</p><h2>Where the learning happens</h2><p class=\"ise-lead\">Studios, whiteboards and real projects, students work through problems together, closer to an engineering floor than a classroom.</p></div></div>"}, "elements": []}]}]}, {"id": "6287d33", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "cf01ecb", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "cb5e4b1", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ise-band\" style=\"padding-block:var(--section-y);\">\n<div class=\"ise-container\">\n  <div style=\"max-width:52ch;margin-bottom:2.25rem;\"><p class=\"ise-eyebrow\">How you're taught</p><h2>Learning by doing</h2></div>\n  <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;\">\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">Studio-based</h3><p style=\"margin:0;color:var(--ink-70);\">Small teams in a studio, closer to a real engineering floor than a classroom.</p></div>\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">Project-driven</h3><p style=\"margin:0;color:var(--ink-70);\">Every module is anchored in building something real.</p></div>\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">Continuously assessed</h3><p style=\"margin:0;color:var(--ink-70);\">Progress is measured through the work itself, not end-of-year exams alone.</p></div>\n  </div>\n  <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;margin-top:2rem;\">\n    <div><div><div class=\"ise-stat__num\" style=\"color:var(--ul-green);\">50%</div><div class=\"ise-stat__label\" style=\"color:var(--ink-70);\">of the degree in industry</div></div></div>\n    <div><div><div class=\"ise-stat__num\" style=\"color:var(--ul-green);\">5</div><div class=\"ise-stat__label\" style=\"color:var(--ink-70);\">paid residencies</div></div></div>\n    <div><div><div class=\"ise-stat__num\" style=\"color:var(--ul-green);\">MSc</div><div class=\"ise-stat__label\" style=\"color:var(--ink-70);\">or BSc after 3 years</div></div></div>\n  </div>\n</div></div>"}, "elements": []}]}]}, {"id": "c6d24f2", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "4b22d75", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "4bcb7d8", "elType": "widget", "wid