{"version": "0.4", "title": "Course", "type": "page", "page_settings": [], "content": [{"id": "fdbe409", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "a51ed34", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "0459907", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ise-nav\" style=\"\">\n<div class=\"ise-container\" style=\"display:flex;align-items:center;justify-content:space-between;padding-block:1.1rem;gap:1rem;flex-wrap:wrap;\">\n  <a href=\"/\" style=\"display:inline-flex;align-items:center;\"><img src=\"/wp-content/themes/hello-elementor-child/assets/ise-ul-logo.png\" alt=\"Immersive Software Engineering · University of Limerick\" style=\"height:40px;width:auto;\"></a>\n  <nav style=\"display:flex;gap:1.6rem;align-items:center;font-weight:500;flex-wrap:wrap;\">\n    <a href=\"/students\" style=\"text-decoration:none;\">The Students</a><a href=\"/companies\" style=\"text-decoration:none;\">The Companies</a><a href=\"/course\" style=\"text-decoration:none;\">Course</a><a href=\"/jobs\" style=\"text-decoration:none;\">Jobs</a><a href=\"/about\" style=\"text-decoration:none;\">About</a><a href=\"/become-a-partner\" style=\"text-decoration:none;\">For partners</a>\n    <a class=\"ise-btn ise-btn--primary\" href=\"https://www.ul.ie/study/undergraduate/immersive-software-engineering-bsc-or-msc\" target=\"_blank\" rel=\"noopener\" style=\"padding:.55rem 1.05rem;background:var(--ul-green-modern);color:#04231a;\">Apply · LM173</a>\n  </nav>\n</div></div>"}, "elements": []}]}]}, {"id": "ca47812", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "1895f8d", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "c862d38", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ise-hero\" style=\"background:#0a3f2c;padding-block:0;\">\n<div class=\"ise-container\" style=\"min-height:clamp(440px,58vh,560px);display:flex;flex-direction:column;justify-content:center;padding-block:5rem 4rem;\">\n  <p class=\"ise-eyebrow\" style=\"color:#8fe3b0;\">The Course</p>\n  <h1 style=\"color:#fff;font-size:var(--fs-h1);margin:.5rem 0 1.1rem;max-width:22ch;\">Four years. Five paid residencies. An integrated MSc.</h1>\n  <p style=\"font-size:var(--fs-lead);color:#e7f2ec;max-width:60ch;\">ISE is a computer science degree where you learn by doing. You graduate with an integrated BSc and MSc, with the option to exit after three years with a BSc (Hons).</p>\n  <div style=\"display:flex;gap:1rem;flex-wrap:wrap;margin-top:1.75rem;\"><a class=\"ise-btn ise-btn--primary\" href=\"https://www.ul.ie/study/undergraduate/immersive-software-engineering-bsc-or-msc\" target=\"_blank\" rel=\"noopener\">Apply now, CAO LM173</a> <a class=\"ise-btn ise-btn--ghost ise-btn--on-dark\" href=\"https://outlook.office365.com/owa/calendar/ISERPCallBookingPage@ulcampus.onmicrosoft.com/bookings/\" target=\"_blank\" rel=\"noopener\">Book a call</a></div>\n</div></div>"}, "elements": []}]}]}, {"id": "a447504", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "2649126", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "e2eaf27", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"\" style=\"padding-block:var(--section-y);\">\n<div class=\"ise-container ise-prose\" style=\"max-width:64ch;\">\n  <p class=\"ise-eyebrow\">Course details</p>\n  <h2>You learn software engineering by doing it</h2>\n  <p>ISE is a computer science degree where you learn by doing, and you graduate with an integrated bachelor's and master's qualification. You spend half your time learning on campus under continuous assessment, and the other half getting paid to solve real problems on residencies in leading companies.</p>\n  <p>Over your four years you complete five paid residencies, spending more than 40 weeks each year learning in a personalised, highly interactive environment, working in small groups with your peers and mentors.</p>\n  <p style=\"font-family:var(--font-serif);font-size:1.3rem;color:var(--ul-green-heritage);margin-top:1.5rem;\">Award codes: LM173 BSc and LK315 MSc in Immersive Software Engineering.</p>\n</div></div>"}, "elements": []}]}]}, {"id": "e9123c9", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "2188e84", "elType": "column", "s