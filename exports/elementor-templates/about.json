"full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "72c7fea", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "070ec1d", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ise-hero\" style=\"background:#0a3f2c;padding-block:0;\">\n<div class=\"ise-container\" style=\"min-height:clamp(440px,58vh,560px);display:flex;flex-direction:column;justify-content:center;padding-block:5rem 4rem;\">\n  <p class=\"ise-eyebrow\" style=\"color:#8fe3b0;\">About</p>\n  <h1 style=\"color:#fff;font-size:var(--fs-h1);margin:.5rem 0 1.1rem;max-width:20ch;\">Immersive Software Engineering at UL</h1>\n  <p style=\"font-size:var(--fs-lead);color:#e7f2ec;max-width:60ch;\">ISE is a radically practical computer science degree at the University of Limerick, built with industry to change how software engineers are trained.</p>\n  <div style=\"display:flex;gap:1rem;flex-wrap:wrap;margin-top:1.75rem;\"><a class=\"ise-btn ise-btn--primary\" href=\"/apply\">Apply now — CAO LM173</a> <a class=\"ise-btn ise-btn--ghost ise-btn--on-dark\" href=\"/apply\">Book a call</a></div>\n</div></div>"}, "elements": []}]}]}, {"id": "005d220", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "af5e726", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "2983394", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ise-band\" style=\"padding-block:var(--section-y);\">\n<div class=\"ise-container ise-prose\">\n  <div style=\"max-width:52ch;margin-bottom:1.5rem;\"><p class=\"ise-eyebrow\">Our approach</p><h2>Trained like engineers, not just taught about engineering</h2></div>\n  <p>ISE was designed around a simple idea: the best way to become a great software engineer is to do the work, supported by great teaching. Students split their time between studio-based learning at UL and paid residencies inside real companies — building a portfolio, a network and a master's degree along the way.</p>\n  <p>The programme is delivered in partnership with a network of leading technology companies and Irish start-ups, and is part of the University of Limerick.</p>\n  <p style=\"margin-top:1.25rem;\"><a class=\"ise-btn ise-btn--ghost\" href=\"https://www.ul.ie\" rel=\"noopener\">University of Limerick →</a></p>\n</div></div>"}, "elements": []}]}]}, {"id": "ba3a9a1", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "2cfb1e0", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "6ef78b2", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ise-band--green\" style=\"padding-block:var(--section