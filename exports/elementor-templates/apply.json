argin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "17d269a", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ise-band\" style=\"padding-block:var(--section-y);\">\n<div class=\"ise-container\">\n  <div style=\"max-width:52ch;margin-bottom:2.25rem;\"><p class=\"ise-eyebrow\">How to apply</p><h2>Three steps to a place</h2></div>\n  <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;\">\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">1 · Apply through the CAO</h3><p style=\"margin:0;color:var(--ink-70);\">List Immersive Software Engineering (CAO code LM173) on your CAO application.</p></div>\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">2 · Meet the requirements</h3><p style=\"margin:0;color:var(--ink-70);\">Meet UL's entry requirements for the programme, including maths.</p></div>\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">3 · Talk to us</h3><p style=\"margin:0;color:var(--ink-70);\">Come to a webinar or open day, or book a call with the team to ask anything.</p></div>\n  </div>\n</div></div>"}, "elements": []}]}]}, {"id": "5d31222", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "4c465e0", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right"