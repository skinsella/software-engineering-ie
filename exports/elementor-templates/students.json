{"version": "0.4", "title": "The Students", "type": "page", "page_settings": [], "content": [{"id": "02816aa", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "d7deef7", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "4338593", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ise-nav\" style=\"\">\n<div class=\"ise-container\" style=\"display:flex;align-items:center;justify-content:space-between;padding-block:1.1rem;gap:1rem;flex-wrap:wrap;\">\n  <a href=\"/\" style=\"display:inline-flex;align-items:center;\"><img src=\"/wp-content/themes/hello-elementor-child/assets/ise-ul-logo.png\" alt=\"Immersive Software Engineering · University of Limerick\" style=\"height:40px;width:auto;\"></a>\n  <nav style=\"display:flex;gap:1.6rem;align-items:center;font-weight:500;flex-wrap:wrap;\">\n    <a href=\"/students\" style=\"text-decoration:none;font-weight:700;\">The Students</a><a href=\"/companies\" style=\"text-decoration:none;\">The Companies</a><a href=\"/course\" style=\"text-decoration:none;\">Course</a><a href=\"/jobs\" style=\"text-decoration:none;\">Jobs</a><a href=\"/about\" style=\"text-decoration:none;\">About</a><a href=\"/become-a-partner\" style=\"text-decoration:none;\">For partners</a>\n    <a class=\"ise-btn ise-btn--primary\" href=\"/apply\" style=\"padding:.55rem 1.05rem;background:var(--ul-green-modern);color:#04231a;\">Apply · LM173</a>\n  </nav>\n</div></div>"}, "elements": []}]}]}, {"id": "a750f21", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "2340a5f", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "f50a80a", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ise-hero\" style=\"background:#0a3f2c url('/wp-content/themes/hello-elementor-child/assets/photos/students-hero.jpg') center/cover no-repeat;padding-block:0;\">\n<div class=\"ise-container\" style=\"min-height:clamp(440px,58vh,560px);display:flex;flex-direction:column;justify-content:center;padding-block:5rem 4rem;\">\n  <p class=\"ise-eyebrow\" style=\"color:#8fe3b0;\">The Students</p>\n  <h1 style=\"color:#fff;font-size:var(--fs-h1);margin:.5rem 0 1.1rem;max-width:18ch;\">A cohort companies compete for</h1>\n  <p style=\"font-size:var(--fs-lead);color:#e7f2ec;max-width:60ch;\">ISE takes a small, highly selective intake each year and teaches them to build. By their first residency, partner engineering teams describe them as performing well beyond their years.</p>\n  <div style=\"display:flex;gap:1rem;flex-wrap:wrap;margin-top:1.75rem;\"><a class=\"ise-btn ise-btn--primary\" href=\"/apply\">Apply now — CAO LM173</a> <a class=\"ise-btn ise-btn--ghost ise-btn--on-dark\" href=\"/companies\">Book a call</a></div>\n</div></div>"}, "elements": []}]}]}, {"id": "266e78a", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "d99c60d", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "8851a73", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ise-band\" style=\"padding-block:var(--section-y);\">\n<div class=\"ise-container\">\n  <div style=\"max-width:54ch;margin-bottom:2.5rem;\">\n    <p class=\"ise-eyebrow\">Selective by design</p>\n    <h2>A small intake, chosen for how they build</h2>\n    <p class=\"ise-lead\">Places are limited and demand is high. Students are selected for genuine ability and motivation — not points alone — and the cohort is kept deliberately small so every student takes on real responsibility early.</p>\n  </div>\n  <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;\">\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">A deliberately small cohort</h3><p style=\"margin:0;color:var(--ink-70);\">Small numbers mean real projects, close mentoring and genuine ownership from the first weeks.</p></div>\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">Chosen on ability</h3><p style=\"margin:0;color:var(--ink-70);\">Selected for how candidates actually think and build, and for their drive to make things.</p></div>\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">Diverse and supported</h3><p style=\"margin:0;color:var(--ink-70);\">€10,000 EDI scholarships and a supportive studio culture help widen who gets to take part.</p></div>\n  </div>\n</div></div>"}, "elements": []}]}]}, {"id": "f0c7279", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "e40ae3b", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "e30c328", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"\" style=\"padding-block:var(--section-y);\"><div class=\"ise-container\"><div style=\"max-width:52ch;margin-bottom:2rem;\"><p class=\"ise-eyebrow\">Meet the cohort</p><h2>Real students, real projects</h2></div><div class=\"ise-pcards\"><div class=\"ise-pcard\"><img src=\"/wp-content/themes/hello-elementor-child/assets/photos/cohort-1.jpg\" alt=\"\"><div class=\"ise-pcard__c\"><h3>Built from day one</h3><p>Studio to residency</p></div></div><div class=\"ise-pcard\"><img src=\"/wp-content/themes/hello-elementor-child/assets/photos/cohort-2.jpg\" alt=\"\"><div class=\"ise-pcard__c\"><h3>Selected on substance</h3><p>Chosen for how they build</p></div></div><div class=\"ise-pcard\"><img src=\"/wp-content/themes/hello-elementor-child/assets/photos/cohort-3.jpg\" alt=\"\"><div class=\"ise-pcard__c\"><h3>Ready for industry</h3><p>Beyond their years</p></div></div></div></div></div>"}, "elements": []}]}]}, {"id": "9b9ea5c", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "9ed232e", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "76f894a", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"\" style=\"padding-block:var(--section-y);\">\n<div class=\"ise-container\">\n  <div style=\"max-width:54ch;margin-bottom:2.25rem;\">\n    <p class=\"ise-eyebrow\">How they learn</p>\n    <h2>Learning by doing, from week one</h2>\n    <p class=\"ise-lead\">No lecture-hall-only terms. Students learn in studios, on real projects, assessed continuously — then spend half the degree in paid company residencies.</p>\n  </div>\n  <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;\">\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">Studio-based</h3><p style=\"margin:0;color:var(--ink-70);\">Small teams working in a studio, closer to a real engineering floor than a classroom.</p></div>\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">Project-driven</h3><p style=\"margin:0;color:var(--ink-70);\">Every module is anchored in building something real, not just sitting exams.</p></div>\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">Continuously assessed</h3><p style=\"margin:0;color:var(--ink-70);\">Progress is measured through the work itself, week after week.</p></div>\n  </div>\n</div></div>"}, "elements": []}]}]}, {"id": "bc1e4f5", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "8a01c80", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "7028214", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ise-band--heritage\" style=\"padding-block:var(--section-y);\">\n<div class=\"ise-container\" style=\"display:grid;grid-template-columns:1.1fr 1fr;gap:clamp(2rem,5vw,4rem);align-items:center;\">\n  <div>\n    <p class=\"ise-eyebrow\" style=\"color:#8fe3b0;\">What partners say</p>\n    <h2 style=\"color:#fff;\">Beyond their years</h2>\n    <p style=\"color:#d7e8df;font-size:var(--fs-lead);\">Residency partners consistently report ISE students contributing like engineers with far more experience — shipping real work inside their teams.</p>\n  </div>\n  <blockquote style=\"margin:0;padding:0;border:0;\">\n    <p class=\"ise-serif\" style=\"font-size:clamp(1.4rem,2.6vw,2rem);color:#fff;max-width:34ch;margin:0;line-height:1.3;\">“Software engineering is a wonderful career.”</p>\n    <footer style=\"font-family:var(--font-sans);font-size:1rem;color:#8fe3b0;margin-top:.85rem;\">John Collison · co-founder, Stripe</footer>\n  </blockquote>\n</div></div>"}, "elements": []}]}]}, {"id": "1d94214", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "7ab1467", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "751d1cf", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"\" style=\"padding-block:var(--section-y);\"><div class=\"ise-container\"><div style=\"max-width:54ch;margin-bottom:2rem;\"><p class=\"ise-eyebrow\">Student stories</p><h2>Real projects, in their words</h2></div><div class=\"ise-tcards\"><div class=\"ise-tcard\"><p class=\"ise-tcard__quote\">In my first residency I was shipping code to production within weeks — real features used by real customers. I learned more in three months than I thought was possible.</p><div class=\"ise-tcard__who\"><img src=\"/wp-content/themes/hello-elementor-child/assets/photos/avatar-2.jpg\" alt=\"\"><div><div class=\"ise-tcard__name\">Aoife M.</div><div class=\"ise-tcard__proj\">Residency at Stripe · payments dashboard</div></div></div></div><div class=\"ise-tcard\"><p class=\"ise-tcard__quote\">I went from writing my first real program to building a computer-vision pipeline for a medtech company. ISE throws you in — then makes sure you can swim.</p><div class=\"ise-tcard__who\"><img src=\"/wp-content/themes/hello-elementor-child/assets/photos/avatar-1.jpg\" alt=\"\"><div><div class=\"ise-tcard__name\">Cian D.</div><div class=\"ise-tcard__proj\">Residency at Provizio · sensor data & ML</div></div></div></div><div class=\"ise-tcard\"><p class=\"ise-tcard__quote\">The studio changed how I work. We build together, review each other's code and ship real things. By second year I already felt like an engineer.</p><div class=\"ise-tcard__who\"><img src=\"/wp-content/themes/hello-elementor-child/assets/photos/avatar-3.jpg\" alt=\"\"><div><div class=\"ise-tcard__name\">Eoin R.</div><div class=\"ise-tcard__proj\">Residency at Intercom · internal tooling</div></div></div></div></div></div></div>"}, "elements": []}]}]}, {"id": "11280be", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "dc44f7e", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "c21e50d", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ise-band\" style=\"padding-block:var(--section-y);\">\n<div class=\"ise-container\">\n  <div style=\"max-width:54ch;margin-bottom:2.25rem;\">\n    <p class=\"ise-eyebrow\">Where they go</p>\n    <h2>Two degrees, and a head start</h2>\n    <p class=\"ise-lead\">In four years students complete an integrated BSc and MSc — graduating with a master's, a portfolio of real work, and a network built across multiple residencies.</p>\n  </div>\n  <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;\">\n    <div><div><div class=\"ise-stat__num\" style=\"color:var(--ul-green);\">4 yrs</div><div class=\"ise-stat__label\" style=\"color:var(--ink-70);\">to an integrated master's</div></div></div>\n    <div><div><div class=\"ise-stat__num\" style=\"color:var(--ul-green);\">5</div><div class=\"ise-stat__label\" style=\"color:var(--ink-70);\">company residencies</div></div></div>\n    <div><div><div class=\"ise-stat__num\" style=\"color:var(--ul-green);\">50%</div><div class=\"ise-stat__label\" style=\"color:var(--ink-70);\">of the degree in industry</div></div></div>\n  </div>\n  <div style=\"margin-top:2rem;\"><a class=\"ise-btn ise-btn--ghost\" href=\"/careers\">Explore graduate paths →</a></div>\n</div></div>"}, "elements": []}]}]}, {"id": "abbf5a8", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "4d1f41d", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "8acbcb4", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ise-band--green\" style=\"padding-block:var(--section-y);\">\n<div class=\"ise-container\" style=\"text-align:center;max-width:760px;\">\n  <h2 style=\"color:#fff;\">Think you could be one of them?</h2>\n  <p style=\"color:#e7f2ec;font-size:var(--fs-lead);\">Applications for 2026 are open through the CAO with code LM173.</p>\n  <div style=\"display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;margin-top:1.5rem;\"><a class=\"ise-btn ise-btn--on-dark\" href=\"/apply\">Apply — LM173</a> <a class=\"ise-btn ise-btn--ghost ise-btn--on-dark\" href=\"/companies\">Talk to us</a></div>\n</div></div>"}, "elements": []}]}]}, {"id": "23bbbed", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "1fb397b", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "5508429", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ise-footer\">\n<div class=\"ise-container\" style=\"display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:2rem;padding-block:3.5rem 2rem;\">\n  <div>\n    <img src=\"/wp-content/themes/hello-elementor-child/assets/ise-ul-logo.png\" alt=\"ISE · University of Limerick\" style=\"height:40px;width:auto;margin-bottom:.35rem;\">\n    <p style=\"max-width:34ch;margin:.75rem 0 0;color:#a9c9bb;\">Immersive Software Engineering, University of Limerick. A radically practical computer science degree.</p>\n  </div>\n  <div><h3 style=\"color:#fff;font-size:1rem;\">Explore</h3><p style=\"line-height:2;margin:.5rem 0 0;\"><a href=\"/students\">The Students</a><br><a href=\"/companies\">The Companies</a><br><a href=\"/course\">Course</a></p></div>\n  <div><h3 style=\"color:#fff;font-size:1rem;\">Apply</h3><p style=\"line-height:2;margin:.5rem 0 0;\"><a href=\"/apply\">How to apply</a><br><a href=\"/why-ise\">Why ISE</a><br><a href=\"/faq\">FAQ</a></p></div>\n  <div><h3 style=\"color:#fff;font-size:1rem;\">Connect</h3><p style=\"line-height:2;margin:.5rem 0 0;\"><a href=\"/about\">About us</a><br><a href=\"/companies\">Partner with us</a><br><a href=\"/careers\">Careers</a><br><a href=\"/profile\">Student portal</a><br><a href=\"/my-applications\">My applications</a><br><a href=\"/my-applicants\">My applicants</a></p></div>\n</div>\n<div style=\"border-top:1px solid rgba(255,255,255,.12);\"><div class=\"ise-container\" style=\"display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;padding-block:1.25rem;color:#a9c9bb;font-size:.9rem;\"><span>© 2026 University of Limerick</span><span><a href=\"/privacy\">Privacy</a> · CAO code LM173 · software-engineering.ie</span></div></div></div>"}, "elements": []}]}]}]}