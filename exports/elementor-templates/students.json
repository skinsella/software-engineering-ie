true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "25d5e05", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "7dd670d", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ise-hero\" style=\"background:#0a3f2c;padding-block:0;\">\n<div class=\"ise-container\" style=\"min-height:clamp(440px,58vh,560px);display:flex;flex-direction:column;justify-content:center;padding-block:5rem 4rem;\">\n  <p class=\"ise-eyebrow\" style=\"color:#8fe3b0;\">The Students</p>\n  <h1 style=\"color:#fff;font-size:var(--fs-h1);margin:.5rem 0 1.1rem;max-width:18ch;\">A cohort companies compete for</h1>\n  <p style=\"font-size:var(--fs-lead);color:#e7f2ec;max-width:60ch;\">ISE takes a small, highly selective intake each year and teaches them to build. By their first residency, partner engineering teams describe them as performing well beyond their years.</p>\n  <div style=\"display:flex;gap:1rem;flex-wrap:wrap;margin-top:1.75rem;\"><a class=\"ise-btn ise-btn--primary\" href=\"/apply\">Apply now — CAO LM173</a> <a class=\"ise-btn ise-btn--ghost ise-btn--on-dark\" href=\"/companies\">Book a call</a></div>\n</div></div>"}, "elements": []}]}]}, {"id": "cd731ba", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "053824d", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "0a70ef0", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ise-band\" style=\"padding-block:var(--section-y);\">\n<div class=\"ise-container\">\n  <div style=\"max-width:54ch;margin-bottom:2.5rem;\">\n    <p class=\"ise-eyebrow\">Selective by design</p>\n    <h2>A small intake, chosen for how they build</h2>\n    <p class=\"ise-lead\">Places are limited and demand is high. Students are selected for genuine ability and motivation — not points alone — and the cohort is kept deliberately small so every student takes on real responsibility early.</p>\n  </div>\n  <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;\">\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">A deliberately small cohort</h3><p style=\"margin:0;color:var(--ink-70);\">Small numbers mean real projects, close mentoring and genuine ownership from the first weeks.</p></div>\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">Chosen on ability</h3><p style=\"margin:0;color:var(--ink-70);\">Selected for how candidates actually think and build, and for their drive to make things.</p></div>\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">Diverse and supported</h3><p style=\"margin:0;color:var(--ink-70);\">€10,000 EDI scholarships and a supportive studio culture help widen who gets to take part.</p></div>\n  </div>\n</div></div>"}, "elements": []}]}]}, {"id": "066ea00", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "6b3fb74", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "c181f85", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"\" style=\"padding-block:var(--section-y);\">\n<div class=\"ise-container\">\n  <div style=\"max-width:54ch;margin-bottom:2.25rem;\">\n    <p class=\"ise-eyebrow\">How they learn</p>\n    <h2>Learning by doing, from week one</h2>\n    <p class=\"ise-lead\">No lecture-hall-only terms. Students learn in studios, on real projects, assessed continuously — then spend half the degree in paid company residencies.</p>\n  </div>\n  <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;\">\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">Studio-based</h3><p style=\"margin:0;color:var(--ink-70);\">Small teams working in a studio, closer to a real engineering floor than a classroom.</p></div>\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">Project-driven</h3><p style=\"margin:0;color:var(--ink-70);\">Every module is anchored in building something real, not just sitting exams.</p></div>\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">Continuously assessed</h3><p style=\"margin:0;color:var(--ink-70);\">Progress is measured through the work itself, week after week.</p></div>\n  </div>\n</div></div>"}, "elements": []}]}]}, {"id": "0b2205c", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "593dc88", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "03dff04", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ise-band--heritage\" style=\"padding-block:var(--section-y);\">\n<div class=\"ise-container\" style=\"display:grid;grid-template-columns:1.1fr 1fr;gap:clamp(2rem,5vw,4rem);align-items:center;\">\n  <div>\n    <p class=\"ise-eyebrow\" style=\"color:#8fe3b0;\">What partners say</p>\n    <h2 style=\"color:#fff;\">Beyond their years</h2>\n    <p style=\"color:#d7e8df;font-size:var(--fs-lead);\">Residency partners consistently report ISE students contributing like engineers with far more experience — shipping real work inside their teams.</p>\n  </div>\n  <blockquote style=\"margin:0;padding:0;border:0;\">\n    <p class=\"ise-serif\" style=\"font-size:clamp(1.4rem,2.6vw,2rem);color:#fff;max-width:34ch;margin:0;line-height:1.3;\">“Software engineering is a wonderful career.”</p>\n    <footer style=\"font-family:var(--font-sans);font-size:1rem;color:#8fe3b0;margin-top:.85rem;\">John Collison · co-founder, Stripe</footer>\n  </blockquote>\n</div></div>"}, "elements": []}]}]}, {"id": "2abefac", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "7ffc28e", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "ab3a410", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ise-band\" style=\"padding-block:var(--section-y);\">\n<div class=\"ise-container\">\n  <div style=\"max-width:54ch;margin-bottom:2.25rem;\">\n    <p class=\"ise-eyebrow\">Where they go</p>\n    <h2>Two degrees, and a head start</h2>\n    <p class=\"ise-lead\">In four years students complete an integrated BSc and MSc — graduating with a master's, a portfolio of real work, and a network built across multiple residencies.</p>\n  </div>\n  <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;\">\n    <div><div><div class=\"ise-stat__num\" style=\"color:var(--ul-green);\">4 yrs</div><div class=\"ise-stat__label\" style=\"color:var(--ink-70);\">to an integrated master's</div></div></div>\n    <div><div><div class=\"ise-stat__num\" style=\"color:var(--ul-green);\">5</div><div class=\"ise-stat__label\" style=\"color:var(--ink-70);\">company residencies</div></div></div>\n    <div><div><div class=\"ise-stat__num\" style=\"color:var(--ul-green);\">50%</div><div class=\"ise-stat__label\" style=\"color:var(--ink-70);\">of the degree in industry</div></div></div>\n  </div>\n  <div style=\"margin-top:2rem;\"><a class=\"ise-btn ise-btn--ghost\" href=\"/careers\">Explore graduate paths →</a></div>\n</div></div>"}, "elements": []}]}]}, {"id": "763283e", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "b9b8c59", "elType": "column", "settings": 