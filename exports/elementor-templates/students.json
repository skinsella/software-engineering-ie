{"version": "0.4", "title": "The Students", "type": "page", "page_settings": [], "content": [{"id": "88ea282", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "dfcf58c", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "b6bdc09", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ise-nav\" style=\"\">\n<div class=\"ise-container\" style=\"display:flex;align-items:center;justify-content:space-between;padding-block:1.1rem;gap:1rem;flex-wrap:wrap;\">\n  <a href=\"/\" style=\"display:inline-flex;align-items:center;\"><img src=\"/wp-content/themes/hello-elementor-child/assets/ise-ul-logo.png\" alt=\"Immersive Software Engineering · University of Limerick\" style=\"height:40px;width:auto;\"></a>\n  <nav style=\"display:flex;gap:1.6rem;align-items:center;font-weight:500;flex-wrap:wrap;\">\n    <a href=\"/students\" style=\"text-decoration:none;font-weight:700;\">The Students</a><a href=\"/companies\" style=\"text-decoration:none;\">The Companies</a><a href=\"/course\" style=\"text-decoration:none;\">Course</a><a href=\"/jobs\" style=\"text-decoration:none;\">Jobs</a><a href=\"/about\" style=\"text-decoration:none;\">About</a><a href=\"/become-a-partner\" style=\"text-decoration:none;\">For partners</a>\n    <a class=\"ise-btn ise-btn--primary\" href=\"https://www.ul.ie/study/undergraduate/immersive-software-engineering-bsc-or-msc\" target=\"_blank\" rel=\"noopener\" style=\"padding:.55rem 1.05rem;background:var(--ul-green-modern);color:#04231a;\">Apply · LM173</a>\n  </nav>\n</div></div>"}, "elements": []}]}]}, {"id": "c257e78", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "e31c763", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "b6c214c", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ise-hero\" style=\"background:#0a3f2c url('/wp-content/themes/hello-elementor-child/assets/photos/students-hero.jpg') center/cover no-repeat;padding-block:0;\">\n<div class=\"ise-container\" style=\"min-height:clamp(440px,58vh,560px);display:flex;flex-direction:column;justify-content:center;padding-block:5rem 4rem;\">\n  <p class=\"ise-eyebrow\" style=\"color:#8fe3b0;\">The Students</p>\n  <h1 style=\"color:#fff;font-size:var(--fs-h1);margin:.5rem 0 1.1rem;max-width:18ch;\">A cohort companies compete for</h1>\n  <p style=\"font-size:var(--fs-lead);color:#e7f2ec;max-width:60ch;\">ISE takes a small, highly selective intake each year and teaches them to build. By their first residency, partner engineering teams describe them as performing well beyond their years.</p>\n  <div style=\"display:flex;gap:1rem;flex-wrap:wrap;margin-top:1.75rem;\"><a class=\"ise-btn ise-btn--primary\" href=\"https://www.ul.ie/study/undergraduate/immersive-software-engineering-bsc-or-msc\" target=\"_blank\" rel=\"noopener\">Apply now, CAO LM173</a> <a class=\"ise-btn ise-btn--ghost ise-btn--on-dark\" href=\"https://outlook.office365.com/owa/calendar/ISERPCallBookingPage@ulcampus.onmicrosoft.com/bookings/\" target=\"_blank\" rel=\"noopener\">Book a call</a></div>\n</div></div>"}, "elements": []}]}]}, {"id": "aa9baf4", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "5bac155", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "29ec200", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ise-band\" style=\"padding-block:var(--section-y);\">\n<div class=\"ise-container\">\n  <div style=\"max-width:54ch;margin-bottom:2.5rem;\">\n    <p class=\"ise-eyebrow\">Selective by design</p>\n    <h2>A small intake, chosen for how they build</h2>\n    <p class=\"ise-lead\">Places are limited and demand is high. Students are selected for genuine ability and motivation, not points alone, and the cohort is kept deliberately small so every student takes on real responsibility early.</p>\n  </div>\n  <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;\">\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">A deliberately small cohort</h3><p style=\"margin:0;color:var(--ink-70);\">Small numbers mean real projects, close mentoring and genuine ownership from the first weeks.</p></div>\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">Chosen on ability</h3><p style=\"margin:0;color:var(--ink-70);\">Selected for how candidates actually think and build, and for their drive to make things.</p></div>\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">Diverse and supported</h3><p style=\"margin:0;color:var(--ink-70);\">€10,000 EDI scholarships and a supportive studio culture help widen who gets to take part.</p></div>\n  </div>\n</div></div>"}, "elements": []}]}]}, {"id": "0793b42", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "aecdca1", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "8d7da91", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"\" style=\"padding-block:var(--section-y);\"><div class=\"ise-container\"><div style=\"max-width:52ch;margin-bottom:2rem;\"><p class=\"ise-eyebrow\">Meet the cohort</p><h2>Real students, real projects</h2></div><div class=\"ise-pcards\"><div class=\"ise-pcard\"><img src=\"/wp-content/themes/hello-elementor-child/assets/photos/cohort-1.jpg\" alt=\"\"><div class=\"ise-pcard__c\"><h3>Built from day one</h3><p>Studio to residency</p></div></div><div class=\"ise-pcard\"><img src=\"/wp-content/themes/hello-elementor-child/assets/photos/cohort-2.jpg\" alt=\"\"><div class=\"ise-pcard__c\"><h3>Selected on substance</h3><p>Chosen for how they build</p></div></div><div class=\"ise-pcard\"><img src=\"/wp-content/themes/hello-elementor-child/assets/photos/cohort-3.jpg\" alt=\"\"><div class=\"ise-pcard__c\"><h3>Ready for industry</h3><p>Beyond their years</p></div></div></div></div></div>"}, "elements": []}]}]}, {"id": "ac1b184", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "4c955dd", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "01d00ce", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"\" style=\"padding-block:var(--section-y);\">\n<div class=\"ise-container\">\n  <div style=\"max-width:54ch;margin-bottom:2.25rem;\">\n    <p class=\"ise-eyebrow\">How they learn</p>\n    <h2>Learning by doing, from week one</h2>\n    <p class=\"ise-lead\">No lecture-hall-only terms. Students learn in studios, on real projects, assessed continuously, then spend half the degree in paid company residencies.</p>\n  </div>\n  <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;\">\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">Studio-based</h3><p style=\"margin:0;color:var(--ink-70);\">Small teams working in a studio, closer to a real engineering floor than a classroom.</p></div>\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">Project-driven</h3><p style=\"margin:0;color:var(--ink-70);\">Every module is anchored in building something real, not just sitting exams.</p></div>\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">Continuously assessed</h3><p style=\"margin:0;color:var(--ink-70);\">Progress is measured through the work itself, week after week.</p></div>\n  </div>\n</div></div>"}, "elements": []}]}]}, {"id": "a9d8249", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "c575b34", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "6bc47cb", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ise-band--heritage\" style=\"padding-block:var(--section-y);\">\n<div class=\"ise-container\" style=\"display:grid;grid-template-columns:1.1fr 1fr;gap:clamp(2rem,5vw,4rem);align-items:center;\">\n  <div>\n    <p class=\"ise-eyebrow\" style=\"color:#8fe3b0;\">What partners say</p>\n    <h2 style=\"color:#fff;\">Beyond their years</h2>\n    <p style=\"color:#d7e8df;font-size:var(--fs-lead);\">Residency partners consistently report ISE students contributing like engineers with far more experience, shipping real work inside their teams.</p>\n  </div>\n</div></div>"}, "elements": []}]}]}, {"id": "899385e", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "108b4fd", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "52f0ae8", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"\" style=\"padding-block:var(--section-y);\"><div class=\"ise-container\"><div style=\"max-width:54ch;margin-bottom:2rem;\"><p class=\"ise-eyebrow\">Student stories</p><h2>Real projects, in their words</h2></div><div class=\"ise-tcards\"><div class=\"ise-tcard\"><p class=\"ise-tcard__quote\">When I first arrived in Ireland, I couldn't speak English. A few years later, I am graduating with first-class honours through a course that completely changed the direction of my career.</p><div class=\"ise-tcard__who\"><img src=\"/wp-content/themes/hello-elementor-child/assets/photos/student-desiree.jpg\" alt=\"\" loading=\"lazy\" decoding=\"async\"><div><a class=\"ise-tcard__name\" href=\"https://www.linkedin.com/in/desirèe-charles-b0a4b316b/\" target=\"_blank\" rel=\"noopener\" aria-label=\"Desiree Charles Dos Santos on LinkedIn\">Desiree Charles Dos Santos<svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" aria-hidden=\"true\" focusable=\"false\" style=\"vertical-align:-2px;margin-left:.35rem;fill:currentColor;\"><path d=\"M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .78 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .78 23.2 0 22.22 0z\"/></svg></a><div class=\"ise-tcard__proj\">MSc, now a Software Engineer at Analog Devices</div></div></div></div><div class=\"ise-tcard\"><p class=\"ise-tcard__quote\">I was the only one in my school year of 300 who went to UL. I feel so proud of the leap I took, and who I've become.</p><div class=\"ise-tcard__who\"><img src=\"/wp-content/themes/hello-elementor-child/assets/photos/student-josh.jpg\" alt=\"\" loading=\"lazy\" decoding=\"async\"><div><a class=\"ise-tcard__name\" href=\"https://www.linkedin.com/in/joshsloggett/\" target=\"_blank\" rel=\"noopener\" aria-label=\"Josh Sloggett on LinkedIn\">Josh Sloggett<svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" aria-hidden=\"true\" focusable=\"false\" style=\"vertical-align:-2px;margin-left:.35rem;fill:currentColor;\"><path d=\"M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .78 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .78 23.2 0 22.22 0z\"/></svg></a><div class=\"ise-tcard__proj\">BSc, residencies at AWS, Intercom and Stripe; returning to Stripe</div></div></div></div><div class=\"ise-tcard\"><p class=\"ise-tcard__quote\">I'm adding 'researcher' to the list of things I never thought I'd achieve when I started ISE.</p><div class=\"ise-tcard__who\"><img src=\"/wp-content/themes/hello-elementor-child/assets/photos/student-justyna.jpg\" alt=\"\" loading=\"lazy\" decoding=\"async\"><div><a class=\"ise-tcard__name\" href=\"https://www.linkedin.com/in/justyna-przy/\" target=\"_blank\" rel=\"noopener\" aria-label=\"Justyna Przyborska on LinkedIn\">Justyna Przyborska<svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" aria-hidden=\"true\" focusable=\"false\" style=\"vertical-align:-2px;margin-left:.35rem;fill:currentColor;\"><path d=\"M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .78 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .78 23.2 0 22.22 0z\"/></svg></a><div class=\"ise-tcard__proj\">Residencies at Stripe, Analog Devices, AWS and Virtu; now at Stripe</div></div></div></div><div class=\"ise-tcard\"><p class=\"ise-tcard__quote\">I completed four residencies at a diverse range of companies, which is my favourite aspect of the course. It helped me develop both as a programmer and a team member.</p><div class=\"ise-tcard__who\"><img src=\"/wp-content/themes/hello-elementor-child/assets/photos/student-ruairi.jpg\" alt=\"\" loading=\"lazy\" decoding=\"async\"><div><a class=\"ise-tcard__name\" href=\"https://www.linkedin.com/in/ruairíglackin/\" target=\"_blank\" rel=\"noopener\" aria-label=\"Ruairi Glackin on LinkedIn\">Ruairi Glackin<svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" aria-hidden=\"true\" focusable=\"false\" style=\"vertical-align:-2px;margin-left:.35rem;fill:currentColor;\"><path d=\"M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .78 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .78 23.2 0 22.22 0z\"/></svg></a><div class=\"ise-tcard__proj\">BSc, residencies at Transact, AWS and BD; returning to AWS</div></div></div></div><div class=\"ise-tcard\"><p class=\"ise-tcard__quote\">The programme gave me exactly what I was looking for: the opportunity to learn by building, solve real engineering problems alongside industry, and graduate ready to make an impact from day one.</p><div class=\"ise-tcard__who\"><img src=\"/wp-content/themes/hello-elementor-child/assets/photos/student-adam.jpg\" alt=\"\" loading=\"lazy\" decoding=\"async\"><div><a class=\"ise-tcard__name\" href=\"https://www.linkedin.com/in/bxrne/\" target=\"_blank\" rel=\"noopener\" aria-label=\"Adam Byrne on LinkedIn\">Adam Byrne<svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" aria-hidden=\"true\" focusable=\"false\" style=\"vertical-align:-2px;margin-left:.35rem;fill:currentColor;\"><path d=\"M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .78 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .78 23.2 0 22.22 0z\"/></svg></a><div class=\"ise-tcard__proj\">MSc, residencies at Analog Devices, Provizio and Johnson & Johnson</div></div></div></div><div class=\"ise-tcard\"><p class=\"ise-tcard__quote\">We were taught the way students want to be taught: through assignments instead of big exams, with the freedom to build alongside companies and bring what we learned back to class.</p><div class=\"ise-tcard__who\"><img src=\"/wp-content/themes/hello-elementor-child/assets/photos/student-michelle.jpg\" alt=\"\" loading=\"lazy\" decoding=\"async\"><div><a class=\"ise-tcard__name\" href=\"https://www.linkedin.com/in/michelle-vaz/\" target=\"_blank\" rel=\"noopener\" aria-label=\"Michelle Vaz on LinkedIn\">Michelle Vaz<svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" aria-hidden=\"true\" focusable=\"false\" style=\"vertical-align:-2px;margin-left:.35rem;fill:currentColor;\"><path d=\"M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .78 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .78 23.2 0 22.22 0z\"/></svg></a><div class=\"ise-tcard__proj\">BSc, residencies at AWS and Fin; returning to AWS</div></div></div></div></div></div></div>"}, "elements": []}]}]}, {"id": "1ffbfb5", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": 