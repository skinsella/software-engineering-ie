": "f89f7ad", "elType": "section", "settings": {"layout": "full_width", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "544ae03", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "4520d89", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ise-hero\" style=\"background:#0a3f2c;padding-block:0;\">\n<div class=\"ise-container\" style=\"min-height:clamp(440px,58vh,560px);display:flex;flex-direction:column;justify-content:center;padding-block:5rem 4rem;\">\n  <p class=\"ise-eyebrow\" style=\"color:#8fe3b0;\">For Schools</p>\n  <h1 style=\"color:#fff;font-size:var(--fs-h1);margin:.5rem 0 1.1rem;max-width:18ch;\">Schools and outreach</h1>\n  <p style=\"font-size:var(--fs-lead);color:#e7f2ec;max-width:60ch;\">We run talks, workshops and activities for second-level students, teachers and guidance counsellors, giving students a real sense of what a career in software engineering looks like and how ISE gets them there.</p>\n  <div style=\"display:flex;gap:1rem;flex-wrap:wrap;margin-top:1.75rem;\"><a class=\"ise-btn ise-btn--primary\" href=\"mailto:ISE@ul.ie?subject=Schools%20outreach%20enquiry\">Book an outreach activity</a> <a class=\"ise-btn ise-btn--ghost ise-btn--on-dark\" href=\"/course\">Course details</a></div>\n</div></div>"}, "elements": []}]}]}, {"id": "4911ca6", "elType": "section", "settings": {"layout": "full_width", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "42506b6", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "b2a94b2", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"\" style=\"padding-block:var(--section-y);\">\n<div class=\"ise-container ise-prose\" style=\"max-width:64ch;\">\n  <p class=\"ise-eyebrow\">What we do</p>\n  <h2>Bringing software engineering to your classroom</h2>\n  <p>At Immersive Software Engineering we have built a set of bespoke talks, workshops and activities for second-level students, teachers and guidance counsellors. The aim is to show students what a career in software engineering really involves, and how ISE can start them on that path through learning by doing.</p>\n  <p>We are happy to come to you, run a session online, or host your class at the ISE studio at the University of Limerick, where your students can meet our staff and the students already on the programme.</p>\n</div></div>"}, "elements": []}]}]}, {"id": "2f6c2e1", "elType": "section", "settings": {"layout": "full_width", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "2a87525", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "76e74b0", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ise-band\" style=\"padding-block:var(--section-y);\">\n<div class=\"ise-container\">\n  <div style=\"max-width:54ch;margin-bottom:2rem;\"><p class=\"ise-eyebrow\">Three ways to get involved</p><h2>Whatever suits your school</h2></div>\n  <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;\">\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">We visit your school</h3><p style=\"margin:0;color:var(--ink-70);\">An in-person talk or workshop for your students and teachers, built around what a software engineering career looks like today.</p></div>\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">An online session</h3><p style=\"margin:0;color:var(--ink-70);\">A live online session for students and teachers, easy to fit into a class period from anywhere in the country.</p></div>\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">Visit the ISE studio</h3><p style=\"margin:0;color:var(--ink-70);\">Bring a class to the ISE studio at UL to meet our staff and current students and see how the programme works.</p></div>\n  </div>\n</div></div>"}, "elements": []}]}]}, {"id": "3f779b4", "elType": "section", "settings": {"layout": "full_width", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "fe93b6d", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "93a68d3", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"\" style=\"padding-block:var(--section-y);\">\n<div class=\"ise-container\">\n  <div style=\"max-width:54ch;margin-bottom:2rem;\"><p class=\"ise-eyebrow\">Who it's for</p><h2>Students, teachers and guidance counsellors</h2></div>\n  <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;\">\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">Second-level students</h3><p style=\"margin:0;color:var(--ink-70);\">Transition Year, fifth year and sixth year students who are curious about building software, whatever their points.</p></div>\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">Teachers and guidance counsellors</h3><p style=\"margin:0;color:var(--ink-70);\">A clear picture of the programme and the entrance submission, so you can guide students who would thrive on it.</p></div>\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">Sixth years applying</h3><p style=\"margin:0;color:var(--ink-70);\">For students applying this year we can walk through the CAO route, the entrance submission and what we look for.</p></div>\n  </div>\n  <div style=\"margin-top:1.75rem;display:flex;flex-wrap:wrap;gap:.75rem;\"><a class=\"ise-btn ise-btn--ghost\" href=\"/course\">Course details →</a> <a class=\"ise-btn ise-btn--ghost\" href=\"/entrance-submission\">Entrance submission →</a> <a class=\"ise-btn ise-btn--ghost\" href=\"/why-ise\">Why ISE →</a></div>\n</div></div>"}, "elements": []}]}]}, {"id": "f614863", "elType": "section", "settings": {"layout": "full_width", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom"