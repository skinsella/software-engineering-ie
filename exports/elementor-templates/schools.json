", "isLinked": true}, "structure": "10"}, "elements": [{"id": "02de618", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "8faea41", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"\" style=\"padding-block:var(--section-y);\">\n<div class=\"ise-container\">\n  <div style=\"max-width:54ch;margin-bottom:1.5rem;\"><p class=\"ise-eyebrow\">Where we are</p><h2>Visit the ISE studio at UL</h2>\n  <p class=\"ise-lead\">The ISE studio is at the University of Limerick in Castletroy. We would be glad to host your class.</p></div>\n  <p style=\"color:var(--ink-70);\">University of Limerick, Castletroy, Limerick, V94 Y985.</p>\n  <div style=\"margin-top:1rem;\"><a class=\"ise-btn ise-btn--ghost\" href=\"https://maps.google.com/?q=University+of+Limerick\" target=\"_blank\" rel=\"noopener\">Get directions →</a></div>\n</div></div>"}, "elements": []}]}]}, {"id": "4e575d4", "elType": "section", "settings": {"layout": "full_width", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "988a96c", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "0450121", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ise-band--green\" style=\"padding-block:var(--section-y);\">\n<div class=\"ise-container\" style=\"text-align:center;max-width:760px;\">\n  <h2 style=\"col