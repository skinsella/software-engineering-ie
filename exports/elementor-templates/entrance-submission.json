{"version": "0.4", "title": "Entrance submission", "type": "page", "page_settings": [], "content": [{"id": "19e3759", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "05c413b", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "da0f523", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ise-nav\" style=\"\">\n<div class=\"ise-container\" style=\"display:flex;align-items:center;justify-content:space-between;padding-block:1.1rem;gap:1rem;flex-wrap:wrap;\">\n  <a href=\"/\" style=\"display:inline-flex;align-items:center;\"><img src=\"/wp-content/themes/hello-elementor-child/assets/ise-ul-logo.png\" alt=\"Immersive Software Engineering · University of Limerick\" style=\"height:40px;width:auto;\"></a>\n  <nav style=\"display:flex;gap:1.6rem;align-items:center;font-weight:500;flex-wrap:wrap;\">\n    <a href=\"/students\" style=\"text-decoration:none;\">The Students</a><a href=\"/companies\" style=\"text-decoration:none;\">The Companies</a><a href=\"/course\" style=\"text-decoration:none;\">Course</a><a href=\"/jobs\" style=\"text-decoration:none;\">Jobs</a><a href=\"/about\" style=\"text-decoration:none;\">About</a><a href=\"/become-a-partner\" style=\"text-decoration:none;\">For partners</a>\n    <a class=\"ise-btn ise-btn--primary\" href=\"https://www.ul.ie/study/undergraduate/immersive-software-engineering-bsc-or-msc\" target=\"_blank\" rel=\"noopener\" style=\"padding:.55rem 1.05rem;background:var(--ul-green-modern);color:#04231a;\">Apply · LM173</a>\n  </nav>\n</div></div>"}, "elements": []}]}]}, {"id": "353f8e8", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "abbe45a", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "7396203", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ise-hero\" style=\"background:#0a3f2c;padding-block:0;\">\n<div class=\"ise-container\" style=\"min-height:clamp(440px,58vh,560px);display:flex;flex-direction:column;justify-content:center;padding-block:5rem 4rem;\">\n  <p class=\"ise-eyebrow\" style=\"color:#8fe3b0;\">Applying</p>\n  <h1 style=\"color:#fff;font-size:var(--fs-h1);margin:.5rem 0 1.1rem;max-width:18ch;\">The ISE entrance submission</h1>\n  <p style=\"font-size:var(--fs-lead);color:#e7f2ec;max-width:60ch;\">ISE looks beyond points. Alongside your CAO application you complete an entrance submission, worth up to 200 points, so we can see how you think and build. Please read this page carefully before you begin.</p>\n  <div style=\"display:flex;gap:1rem;flex-wrap:wrap;margin-top:1.75rem;\"><a class=\"ise-btn ise-btn--primary\" href=\"https://www.ul.ie/study/undergraduate/immersive-software-engineering-bsc-or-msc\" target=\"_blank\" rel=\"noopener\">Apply now, CAO LM173</a> <a class=\"ise-btn ise-btn--ghost ise-btn--on-dark\" href=\"mailto:ISE@ul.ie\">Email ISE@ul.ie</a></div>\n</div></div>"}, "elements": []}]}]}, {"id": "40f827a", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "f23ea9c", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "4cb8c0b", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"\" style=\"padding-block:var(--section-y);\">\n<div class=\"ise-container ise-prose\" style=\"max-width:64ch;\">\n  <p class=\"ise-eyebrow\">Please read carefully</p>\n  <h2>Two options, both worth up to 200 points</h2>\n  <p>The ISE entrance submission has two options, each worth a maximum of 200 points. It applies to CAO (Leaving Certificate), mature and international applicants to Immersive Software Engineering, CAO code LM173. We are interested in many kinds of students, so show us your skills and interests in science, technology, engineering, maths and innovation, in a way that connects with you.</p>\n  <p>Once you select LM173 on the CAO you will receive an email with a link to the submission portal. International applicants apply directly to UL and receive the same link. If you have any questions, email <a href=\"mailto:ISE@ul.ie\">ISE@ul.ie</a>.</p>\n</div></div>"}, "elements": []}]}]}, {"id": "eef62a2", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "82d2af1", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "7369054", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ise-band\" style=\"padding-block:var(--section-y);\">\n<div class=\"ise-container\">\n  <div style=\"max-width:58ch;margin-bottom:2rem;\"><p class=\"ise-eyebrow\">Choose one route</p><h2>Two routes, one submission</h2>\n  <p class=\"ise-lead\">Choose one of two routes. Both carry equal marks and are worth up to 200 points. Pick the one that lets you best show your skills and interests.</p></div>\n  <div style=\"display:grid;grid-template-columns:repeat(2,1fr);gap:1.5rem;margin-bottom:2rem;\">\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">Route A · Technology Project</h3><p style=\"margin:0;color:var(--ink-70);\">Up to 800 words on a project where you used technology to do something interesting. Tell us what you did and how you did it, with evidence.</p></div>\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">Route B · Personal Profile</h3><p style=\"margin:0;color:var(--ink-70);\">Respond to three of four questions, up to 400 words each. A shorter, narrative route that suits applicants with or without hands-on software experience.</p></div>\n  </div>\n  <div style=\"overflow-x:auto;border-radius:var(--radius-lg);border:1px solid var(--line);\"><table style=\"width:100%;border-collapse:collapse;font-size:.95rem;min-width:560px;background:#fff;\"><thead><tr><th style=\"text-align:left;padding:.75rem 1rem;border-bottom:2px solid var(--ul-green);\"></th><th style=\"text-align:left;padding:.75rem 1rem;border-bottom:2px solid var(--ul-green);color:var(--ul-green-heritage);\">Route A<br>Technology Project</th><th style=\"text-align:left;padding:.75rem 1rem;border-bottom:2px solid var(--ul-green);color:var(--ul-green-heritage);\">Route B<br>Personal Profile</th></tr></thead><tbody><tr><td style=\"padding:.7rem 1rem;border-bottom:1px solid var(--line);font-weight:700;\">Graded questions</td><td style=\"padding:.7rem 1rem;border-bottom:1px solid var(--line);color:var(--ink-70);\">One written report</td><td style=\"padding:.7rem 1rem;border-bottom:1px solid var(--line);color:var(--ink-70);\">Respond to three of four questions</td></tr><tr><td style=\"padding:.7rem 1rem;border-bottom:1px solid var(--line);font-weight:700;\">Word limit</td><td style=\"padding:.7rem 1rem;border-bottom:1px solid var(--line);color:var(--ink-70);\">Up to 800 words</td><td style=\"padding:.7rem 1rem;border-bottom:1px solid var(--line);color:var(--ink-70);\">Up to 400 words per response</td></tr><tr><td style=\"padding:.7rem 1rem;border-bottom:1px solid var(--line);font-weight:700;\">Question type</td><td style=\"padding:.7rem 1rem;border-bottom:1px solid var(--line);color:var(--ink-70);\">Essay</td><td style=\"padding:.7rem 1rem;border-bottom:1px solid var(--line);color:var(--ink-70);\">Shorter narrative</td></tr><tr><td style=\"padding:.7rem 1rem;border-bottom:1px solid var(--line);font-weight:700;\">Main focus</td><td style=\"padding:.7rem 1rem;border-bottom:1px solid var(--line);color:var(--ink-70);\">Creative use of technology</td><td style=\"padding:.7rem 1rem;border-bottom:1px solid var(--line);color:var(--ink-70);\">Personal characteristics and achievements</td></tr><tr><td style=\"padding:.7rem 1rem;border-bottom:1px solid var(--line);font-weight:700;\">Evidence</td><td style=\"padding:.7rem 1rem;border-bottom:1px solid var(--line);color:var(--ink-70);\">Yes</td><td style=\"padding:.7rem 1rem;border-bottom:1px solid var(--line);color:var(--ink-70);\">Yes</td></tr><tr><td style=\"padding:.7rem 1rem;border-bottom:1px solid var(--line);font-weight:700;\">Points</td><td style=\"padding:.7rem 1rem;border-bottom:1px solid var(--line);color:var(--ink-70);\">200</td><td style=\"padding:.7rem 1rem;border-bottom:1px solid var(--line);color:var(--ink-70);\">200</td></tr><tr><td style=\"padding:.7rem 1rem;border-bottom:1px solid var(--line);font-weight:700;\">Submission</td><td style=\"padding:.7rem 1rem;border-bottom:1px solid var(--line);color:var(--ink-70);\">Upload a single document to the portal</td><td style=\"padding:.7rem 1rem;border-bottom:1px solid var(--line);color:var(--ink-70);\">Enter responses in the portal</td></tr></tbody></table></div>\n</div></div>"}, "elements": []}]}]}, {"id": "9dc9aa4", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "8ea2392", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "2b4d801", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"\" style=\"padding-block:var(--section-y);\">\n<div class=\"ise-container\">\n  <div style=\"max-width:56ch;margin-bottom:2rem;\"><p class=\"ise-eyebrow\">The submission</p><h2>Three steps</h2></div>\n  <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;\">\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">1 · Personal details</h3><p style=\"margin:0;color:var(--ink-70);\">Not graded. Your name, email, CAO number if applicable, and mobile number. Use the email from your original CAO or UL application, and give your mobile with the country code in 00 format, not +.</p></div>\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">2 · Choose your route</h3><p style=\"margin:0;color:var(--ink-70);\">Choose Route A or Route B. Both carry equal marks and are worth up to 200 points. Pick the one that best represents you.</p></div>\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">3 · Final stage and submission</h3><p style=\"margin:0;color:var(--ink-70);\">Not graded. Sign an honour pledge that the work is your own and that all sources are acknowledged. Your work can be part of a team project, but the submission must focus on your own contribution. Anything found not to be your own work leads to rejection of the whole submission.</p></div>\n  </div>\n</div></div>"}, "elements": []}]}]}, {"id": "cbd0df3", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "4d1ce32", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "6893a63", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ise-band\" style=\"padding-block:var(--section-y);\">\n<div class=\"ise-container\">\n  <div style=\"max-width:62ch;margin-bottom:2rem;\"><p class=\"ise-eyebrow\">Route A guidance</p><h2>The Technology Project</h2>\n  <p class=\"ise-lead\">Up to 800 words, submitted as a single document through the portal. Using technology does not have to mean writing a program; it can be any situation where you used technology to do something interesting. We want to know what you did, and just as much, how you did it.</p></div>\n  <div style=\"display:grid;grid-template-columns:repeat(2,1fr);gap:1.5rem;\">\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">Overview of your work</h3><p style=\"margin:0;color:var(--ink-70);\">What did you do? Include screenshots, photos and links to repositories, websites or other illustrations. If you wrote code, add short fragments with a brief explanation of what they do, and link to the full implementation.</p></div>\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">Project impact</h3><p style=\"margin:0;color:var(--ink-70);\">Why did you do it? Were you solving a problem or learning something new? What was the impact, and did anyone use it? What are you most proud of, and what would you do differently next time?</p></div>\n  </div>\n  <div style=\"margin-top:1.5rem;\"><div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">A few notes</h3><p style=\"margin:0;color:var(--ink-70);\">Team projects are fine, but be clear about the parts you did yourself. Leaving Certificate or other coursework projects are allowed if you improve on them and explain how. Always provide and explain your evidence. If you are unsure whether an idea fits, it probably does, but you can email ISE@ul.ie to check.</p></div></div>\n</div></div>"}, "elements": []}]}]}, {"id": "6cb0f2a", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "cb2c65d", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "2a839a6", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ise-band\" style=\"padding-block:var(--section-y);\">\n<div class=\"ise-container\">\n  <div style=\"max-width:56ch;margin-bottom:1.75rem;\"><p class=\"ise-eyebrow\">Timeline</p><h2>When you will hear from us</h2>\n  <p class=\"ise-lead\">When you hear from us depends on when you select LM173 on the CAO.</p></div>\n  <svg viewBox=\"0 0 960 230\" role=\"img\" aria-label=\"Entrance submission timeline: when applicants hear from ISE based on when LM173 is selected on the CAO\" style=\"width:100%;height:auto;max-width:960px;display:block;margin:0 auto;font-family:Inter,sans-serif;\"><line x1=\"130\" y1=\"112\" x2=\"830\" y2=\"112\" stroke=\"#cfe0d6\" stroke-width=\"3\"></line><rect x=\"48\" y=\"20\" width=\"224\" height=\"64\" rx=\"14\" fill=\"#e8f1ec\"></rect><text x=\"160\" y=\"48\" text-anchor=\"middle\" font-size=\"15\" font-weight=\"700\" fill=\"#0a3f2c\">Apply by</text><text x=\"160\" y=\"68\" text-anchor=\"middle\" font-size=\"15\" font-weight=\"700\" fill=\"#0a3f2c\">1 February</text><circle cx=\"160\" cy=\"112\" r=\"16\" fill=\"#005335\"></circle><text x=\"160\" y=\"117\" text-anchor=\"middle\" font-size=\"14\" font-weight=\"700\" fill=\"#ffffff\">1</text><text x=\"160\" y=\"158\" text-anchor=\"middle\" font-size=\"11\" fill=\"#77857e\" letter-spacing=\".06em\">THEN</text><text x=\"160\" y=\"180\" text-anchor=\"middle\" font-size=\"13\" font-weight=\"600\" fill=\"#0a6b3b\">Emailed early to mid March</text><rect x=\"368\" y=\"20\" width=\"224\" height=\"64\" rx=\"14\" fill=\"#e8f1ec\"></rect><text x=\"480\" y=\"48\" text-anchor=\"middle\" font-size=\"15\" font-weight=\"700\" fill=\"#0a3f2c\">After 1 Feb,</text><text x=\"480\" y=\"68\" text-anchor=\"middle\" font-size=\"15\" font-weight=\"700\" fill=\"#0a3f2c\">up to 1 May</text><circle cx=\"480\" cy=\"112\" r=\"16\" fill=\"#005335\"></circle><text x=\"480\" y=\"117\" text-anchor=\"middle\" font-size=\"14\" font-weight=\"700\" fill=\"#ffffff\">2</text><text x=\"480\" y=\"158\" text-anchor=\"middle\" font-size=\"11\" fill=\"#77857e\" letter-spacing=\".06em\">THEN</text><text x=\"480\" y=\"180\" text-anchor=\"middle\" font-size=\"13\" font-weight=\"600\" fill=\"#0a6b3b\">Emailed by mid May</text><rect x=\"688\" y=\"20\" width=\"224\" height=\"64\" rx=\"14\" fill=\"#e8f1ec\"></rect><text x=\"800\" y=\"48\" text-anchor=\"middle\" font-size=\"15\" font-weight=\"700\" fill=\"#0a3f2c\">Change of Mind,</text><text x=\"800\" y=\"68\" text-anchor=\"middle\" font-size=\"15\" font-weight=\"700\" fill=\"#0a3f2c\">up to 1 July</text><circle cx=\"800\" cy=\"112\" r=\"16\" fill=\"#005335\"></circle><text x=\"800\" y=\"117\" text-anchor=\"middle\" font-size=\"14\" font-weight=\"700\" fill=\"#ffffff\">3</text><text x=\"800\" y=\"158\" text-anchor=\"middle\" font-size=\"11\" fill=\"#77857e\" letter-spacing=\".06em\">THEN</text><text x=\"800\" y=\"180\" text-anchor=\"middle\" font-size=\"13\" font-weight=\"600\" fill=\"#0a6b3b\">Emailed by mid July</text></svg>\n  <p style=\"margin:1.25rem auto 0;max-width:70ch;text-align:center;color:var(--ink-70);\">Dates may differ for international applicants; contact UL Admissions for details.</p>\n</div></div>"}, "elements": []}]}]}, {"id": "c3f0d41", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "6d5df4f", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "04734c9", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"\" style=\"padding-block:var(--section-y);\">\n<div class=\"ise-container\">\n  <div style=\"max-width:56ch;margin-bottom:2rem;\"><p class=\"ise-eyebrow\">Good to know</p><h2>Before you submit</h2></div>\n  <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;\">\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">You may be invited to talk</h3><p style=\"margin:0;color:var(--ink-70);\">You may be called for a short online discussion to clarify parts of your submission. You will hear more when you receive your portal link.</p></div>\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">Everyone submits</h3><p style=\"margin:0;color:var(--ink-70);\">Mature and international applicants complete the submission too. Mature applicants also send a short motivation letter; email ISE@ul.ie for instructions.</p></div>\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">Watch the workshop</h3><p style=\"margin:0;color:var(--ink-70);\">For a full walkthrough, watch the ISE Entrance Submission Workshop on the ISE YouTube channel.</p></div>\n  </div>\n  <div style=\"margin-top:1.75rem;\"><a class=\"ise-btn ise-btn--ghost\" href=\"https://www.youtube.com/@immersiveSE\" target=\"_blank\" rel=\"noopener\">ISE on YouTube →</a> <a class=\"ise-btn ise-btn--ghost\" href=\"mailto:ISE@ul.ie\">Email ISE@ul.ie</a></div>\n</div></div>"}, "elements": []}]}]}, {"id": "677b4e6", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "86a8360", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "2a8c66a", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"\" style=\"padding-block:var(--section-y);\">\n<div class=\"ise-container\">\n  <div style=\"max-width:56ch;margin-bottom:1.5rem;\"><p class=\"ise-eyebrow\">FAQ</p><h2>Frequently asked questions</h2></div>\n  <div class=\"ise-faq\" style=\"max-width:820px;\"><details><summary>What are the differences between the Technology Project and the Personal Profile?</summary><p>Route A (Technology Project) is a single written report of up to 800 words focused on creative use of technology. Route B (Personal Profile) asks you to respond to three of four questions, up to 400 words each, as shorter narratives focused on your personal characteristics and achievements. Both carry 200 points and both require evidence. Route B opens the course to students who may not have an extensive technical background.</p></details><details><summary>Can I gain a place on ISE without completing an entrance submission?</summary><p>No. All applicants, through the CAO or by direct application to UL, must submit either Route A or Route B.</p></details><details><summary>What are the minimum requirements aside from the entrance submission?</summary><p>Full course entry requirements are on the University of Limerick website.</p></details><details><summary>Can I make changes after I have submitted?</summary><p>No, changes cannot be made once you send your submission through the portal. Email ISE@ul.ie with any queries.</p></details><details><summary>I have not received the link to complete my submission. What should I do?</summary><p>Check your spam or junk folder first. If you still cannot find the email, contact ISE@ul.ie.</p></details><details><summary>I am a mature student. Do I need to complete an entrance submission?</summary><p>Yes. Mature students also submit a short motivation letter outlining why they would like a place on ISE. Email ISE@ul.ie for instructions on submitting it.</p></details><details><summary>I am an international student. Do I need to complete the entrance submission?</summary><p>Yes. All applicants complete either Route A or Route B.</p></details><details><summary>Can I choose both Route A and Route B?</summary><p>No, choose only one. Pick the option that best represents you.</p></details><details><summary>Is ISE a restricted course?</summary><p>No. ISE can be selected in each of the three submission windows (normal CAO, late applications and Change of Mind), unlike restricted courses such as Medicine.</p></details><details><summary>Can I use a Leaving Certificate project?</summary><p>Yes, if it meets the criteria. Try to make it unique and add something to it, especially if other students may have similar projects.</p></details><details><summary>Can I use a group project?</summary><p>Yes, but clearly specify which parts you worked on, as you may be called for an interview to discuss it further.</p></details></div>\n</div></div>"}, "elements": []}]}]}, {"id": "c0ccf3b", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "e2dde7a", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "78ff45b", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ise-band--green\" style=\"padding-block:var(--section-y);\">\n<div class=\"ise-container\" style=\"text-align:center;max-width:760px;\">\n  <h2 style=\"color:#fff;\">Questions about the submission?</h2>\n  <p style=\"color:#e7f2ec;font-size:var(--fs-lead);\">Email the ISE admissions team, or apply through the CAO with code LM173.</p>\n  <div style=\"display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;margin-top:1.5rem;\"><a class=\"ise-btn ise-btn--primary\" href=\"https://www.ul.ie/study/undergraduate/immersive-software-engineering-bsc-or-msc\" target=\"_blank\" rel=\"noopener\">Apply now, CAO LM173</a> <a class=\"ise-btn ise-btn--ghost ise-btn--on-dark\" href=\"mailto:ISE@ul.ie\">Email ISE@ul.ie</a></div>\n</div></div>"}, "elements": []}]}]}, {"id": "b4d0382", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "db90644", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "3f89dd6", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ise-footer\">\n<div class=\"ise-container\" style=\"display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:2rem;padding-block:3.5rem 2rem;\">\n  <div>\n    <img src=\"/wp-content/themes/hello-elementor-child/assets/ise-ul-logo.png\" alt=\"ISE · University of Limerick\" style=\"height:40px;widt