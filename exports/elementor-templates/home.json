e8", "elType": "section", "settings": {"layout": "full_width", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "0d8f623", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "81e0bcb", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"\" style=\"padding-block:var(--section-y);\">\n<div class=\"ise-container\">\n  <div style=\"max-width:54ch;margin-bottom:2.5rem;\">\n    <p class=\"ise-eyebrow\">The Students</p>\n    <h2>A small, highly selective cohort</h2>\n    <p class=\"ise-lead\">ISE admits a small group each year, chosen for how they actually think and build. Students join partner engineering teams as paid contributors from early in the programme.</p>\n  </div>\n  <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;\">\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">Selected on substance</h3><p style=\"margin:0;color:var(--ink-70);\">A highly selective intake focused on genuine ability, not points alone, we look for real builders.</p></div>\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">Learning by shipping</h3><p style=\"margin:0;color:var(--ink-70);\">Studio-based, project-driven and continuously assessed. Students build from week one.</p></div>\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">