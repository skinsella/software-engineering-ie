 "widgetType": "html", "settings": {"html": "<div class=\"\" style=\"padding-block:var(--section-y);\">\n<div class=\"ise-container\">\n  <div style=\"max-width:54ch;margin-bottom:2.5rem;\">\n    <p class=\"ise-eyebrow\">The Students</p>\n    <h2>The most capable cohort in the country</h2>\n    <p class=\"ise-lead\">ISE admits a small, highly selective group each year, chosen for how they actually think and build. The result is a cohort that companies compete to work with.</p>\n  </div>\n  <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;\">\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">Selected on substance</h3><p style=\"margin:0;color:var(--ink-70);\">A highly selective intake focused on genuine ability, not points alone — we look for real builders.</p></div>\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">Learning by shipping</h3><p style=\"margin:0;color:var(--ink-70);\">Studio-based, project-driven and continuously assessed. Students build from week one.</p></div>\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">Ready for industry</h3><p style=\"margin:0;color:var(--ink-70);\">Partners report students performing well beyond their years by their very first residency.</p></div>\n  </div>\n  <div style=\"margin-top:2rem;\"><a class=\"ise-btn ise-btn--ghost\" href=\"/students\">Meet the students →</a></div>\n</div></div>"}, "elements": []}]}]}, {"id": "1161245", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements":