, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "094f67b", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "d92bc0d", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ise-hero\" style=\"background:#0a3f2c;padding-block:var(--section-y);\">\n<div class=\"ise-container\" style=\"min-height:clamp(560px,78vh,720px);display:flex;flex-direction:column;justify-content:center;padding-block:6rem 5rem;\">\n  <p class=\"ise-eyebrow\" style=\"color:#8fe3b0;\">Immersive Software Engineering · University of Limerick</p>\n  <h1 style=\"color:#fff;font-size:var(--fs-hero);margin:.6rem 0 1.25rem;max-width:17ch;\">Exceptional students. World-class companies.</h1>\n  <p style=\"font-size:var(--fs-lead);color:#e7f2ec;max-width:60ch;\">A four-year integrated BSc and MSc where you learn by doing — spending almost half of your degree in paid residencies with the best software companies in the world.</p>\n  <div style=\"display:flex;gap:1rem;flex-wrap:wrap;margin-top:2rem;\">\n    <a class=\"ise-btn ise-btn--primary\" href=\"/apply\">Apply now — CAO LM173</a>\n    <a class=\"ise-btn ise-btn--ghost ise-btn--on-dark\" href=\"/companies\">Book a call</a>\n  </div>\n</div></div>"}, "elements": []}]}]}, {"id": "dd31870", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "231189a", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "9898a87", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"ise-band\" style=\"padding-block:var(--section-y);\">\n<div class=\"ise-container\" style=\"display:grid;grid-template-columns:1.3fr 1fr;gap:clamp(2rem,5vw,4rem);align-items:center;\">\n  <p class=\"ise-serif\" style=\"font-size:clamp(1.4rem,2.6vw,2.05rem);color:var(--ul-green-heritage);line-height:1.35;margin:0;\">ISE is a computer science degree where you learn by doing — not in lecture halls, but in studios and inside real companies, shipping real software from first year.</p>\n  <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem;\">\n    <div><div class=\"ise-stat__num\">45%</div><div class=\"ise-stat__label\">in paid residency</div></div>\n    <div><div class=\"ise-stat__num\">4 yrs</div><div class=\"ise-stat__label\">BSc + MSc</div></div>\n    <div><div class=\"ise-stat__num\">5</div><div class=\"ise-stat__label\">residencies</div></div>\n  </div>\n</div></div>"}, "elements": []}]}]}, {"id": "9839219", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "13ee759", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "45d04db", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"\" style=\"padding-block:var(--section-y);\">\n<div class=\"ise-container\">\n  <div style=\"max-width:54ch;margin-bottom:2.5rem;\">\n    <p class=\"ise-eyebrow\">The Students</p>\n    <h2>The most capable cohort in the country</h2>\n    <p class=\"ise-lead\">ISE admits a small, highly selective group each year, chosen for how they actually think and build. The result is a cohort that companies compete to work with.</p>\n  </div>\n  <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;\">\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">Selected on substance</h3><p style=\"margin:0;color:var(--ink-70);\">A highly selective intake focused on genuine ability, not points alone — we look for real builders.</p></div>\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">Learning by shipping</h3><p style=\"margin:0;color:var(--ink-70);\">Studio-based, project-driven and continuously assessed. Students build from week one.</p></div>\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">Ready for industry</h3><p style=\"margin:0;color:var(--ink-70);\">Partners report students performing well beyond their years by their very first residency.</p></div>\n  </div>\n  <div style=\"margin-top:2rem;\"><a class=\"ise-btn ise-btn--ghost\" href=\"/students\">Meet the students →</a></div>\n</div></div>"}, "elements": []}]}]}, {"id": "8385cdd", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "structure": "10"}, "elements": [{"id": "e8218bc", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0