line_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "49e5c1d", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"\" style=\"padding-block:var(--section-y);\">\n<div class=\"ise-container\">\n  <div style=\"max-width:54ch;margin-bottom:2.25rem;\">\n    <p class=\"ise-eyebrow\">What a residency is</p>\n    <h2>Not an internship. A contribution.</h2>\n    <p class=\"ise-lead\">Students join your team as paid contributors on real work — supported by ISE's academic mentors and a structured learning framework around the placement.</p>\n  </div>\n  <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;\">\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">Paid contributors</h3><p style=\"margin:0;color:var(--ink-70);\">Students are paid and expected to do real, shippable engineering work — not shadowing.</p></div>\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">Three to six months</h3><p style=\"margin:0;color:var(--ink-70);\">Long enough to onboard, take ownership and deliver — across up to five residencies per student.</p></div>\n    <div class=\"ise-card\" style=\"background:#fff;border-color:var(--line);\"><h3 style=\"color:var(--ul-green-heritage);margin:0 0 .5rem;\">Fully supported</h3><p style=\"margin:0;color:var(--ink-70);\">Academic mentors and a learning framework wrap around every placement, sharing the load with your team.</p></div>\n  </div>\n</div></div>"}, "elements": []}]}]}, {"id": "eae891e", "elType": "section", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "i